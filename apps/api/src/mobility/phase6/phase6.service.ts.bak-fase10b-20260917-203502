import {
  BadRequestException,
  ConflictException,
  HttpException,
  HttpStatus,
  Injectable,
  NotFoundException,
} from '@nestjs/common';
import { PrismaService } from '../../prisma/prisma.service';
import {
  AcceptProposalDto,
  CandidateSearchDto,
  CreateNegotiationDto,
  CreateNegotiationPolicyDto,
  DriverAcceptDto,
  DriverCounterDto,
  PassengerOfferDto,
  RouteEstimateDto,
} from './phase6.dto';

@Injectable()
export class MobilityPhase6Service {
  constructor(private readonly prisma: PrismaService) {}

  private money(value: number) {
    return Math.round((value + Number.EPSILON) * 100) / 100;
  }

  private haversineKm(
    lat1: number,
    lng1: number,
    lat2: number,
    lng2: number,
  ) {
    const toRad = (value: number) => (value * Math.PI) / 180;
    const earthKm = 6371;
    const dLat = toRad(lat2 - lat1);
    const dLng = toRad(lng2 - lng1);
    const a =
      Math.sin(dLat / 2) ** 2 +
      Math.cos(toRad(lat1)) *
        Math.cos(toRad(lat2)) *
        Math.sin(dLng / 2) ** 2;
    return earthKm * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  }

  private async audit(
    requestId: string,
    actorType: string,
    actorId: string | undefined,
    action: string,
    proposalId?: string,
    metadata?: Record<string, unknown>,
  ) {
    return this.prisma.mobilityNegotiationAudit.create({
      data: {
        requestId,
        actorType,
        actorId,
        action,
        proposalId,
        metadata: metadata as any,
      },
    });
  }

  private async throttle(
    action: string,
    actorId: string,
    limit: number,
    windowSeconds: number,
  ) {
    const since = new Date(Date.now() - windowSeconds * 1000);
    const count = await this.prisma.mobilityRequestThrottle.count({
      where: {
        action,
        actorId,
        createdAt: { gte: since },
      },
    });

    if (count >= limit) {
      throw new HttpException(
        `Demasiadas solicitudes para ${action}. Intenta mas tarde.`,
        HttpStatus.TOO_MANY_REQUESTS,
      );
    }

    await this.prisma.mobilityRequestThrottle.create({
      data: { action, actorId },
    });
  }

  async createPolicy(dto: CreateNegotiationPolicyDto) {
    if (
      dto.minimumAllowedRatio !== undefined &&
      dto.reasonableOfferRatio !== undefined &&
      dto.minimumAllowedRatio > dto.reasonableOfferRatio
    ) {
      throw new BadRequestException(
        'minimumAllowedRatio no puede ser mayor que reasonableOfferRatio.',
      );
    }

    if (
      dto.reasonableOfferRatio !== undefined &&
      dto.fastMatchRatio !== undefined &&
      dto.reasonableOfferRatio > dto.fastMatchRatio
    ) {
      throw new BadRequestException(
        'reasonableOfferRatio no puede ser mayor que fastMatchRatio.',
      );
    }

    return this.prisma.$transaction(async (tx) => {
      await tx.mobilityNegotiationPolicy.updateMany({
        where: {
          isActive: true,
          city: dto.city ?? null,
        },
        data: { isActive: false },
      });

      return tx.mobilityNegotiationPolicy.create({
        data: {
          name: dto.name,
          city: dto.city,
          baseFare: dto.baseFare ?? 15,
          perKm: dto.perKm ?? 10,
          perMinuteTarget: dto.perMinuteTarget ?? 3,
          minimumFare: dto.minimumFare ?? 50,
          minimumAllowedRatio: dto.minimumAllowedRatio ?? 0.75,
          reasonableOfferRatio: dto.reasonableOfferRatio ?? 0.85,
          fastMatchRatio: dto.fastMatchRatio ?? 1.05,
          maxDriverCounterRatio: dto.maxDriverCounterRatio ?? 1.25,
          platformPercent: dto.platformPercent ?? 8,
          freePickupKm: dto.freePickupKm ?? 2,
          pickupPerKm: dto.pickupPerKm ?? 4,
        },
      });
    });
  }

  async activePolicy(city?: string) {
    if (city) {
      const exact = await this.prisma.mobilityNegotiationPolicy.findFirst({
        where: { isActive: true, city },
        orderBy: { updatedAt: 'desc' },
      });
      if (exact) return exact;
    }

    const generic = await this.prisma.mobilityNegotiationPolicy.findFirst({
      where: { isActive: true, city: null },
      orderBy: { updatedAt: 'desc' },
    });
    if (generic) return generic;

    return this.prisma.mobilityNegotiationPolicy.create({
      data: {
        name: city
          ? `Yaleka Negociacion Base - ${city}`
          : 'Yaleka Negociacion Base',
        city: city ?? null,
        baseFare: 15,
        perKm: 10,
        perMinuteTarget: 3,
        minimumFare: 50,
        minimumAllowedRatio: 0.75,
        reasonableOfferRatio: 0.85,
        fastMatchRatio: 1.05,
        maxDriverCounterRatio: 1.25,
        platformPercent: 8,
        freePickupKm: 2,
        pickupPerKm: 4,
      },
    });
  }

  async estimateRoute(dto: RouteEstimateDto) {
    const straightLineKm = this.haversineKm(
      dto.originLat,
      dto.originLng,
      dto.destinationLat,
      dto.destinationLng,
    );

    // MVP sin proveedor externo:
    // una ruta urbana suele ser mas larga que la linea recta.
    const distanceKm = straightLineKm * 1.25;

    // Velocidad urbana base aproximada para fallback.
    const normalMinutes = Math.max(
      1,
      Math.round((distanceKm / 25) * 60),
    );

    const trafficLevel = dto.trafficLevel ?? 'NORMAL';
    const trafficFactor =
      trafficLevel === 'HEAVY'
        ? 1.6
        : trafficLevel === 'MODERATE'
          ? 1.25
          : 1;

    const trafficDurationMinutes = Math.max(
      normalMinutes,
      Math.round(normalMinutes * trafficFactor),
    );

    return this.prisma.mobilityRouteEstimate.create({
      data: {
        provider: 'FALLBACK',
        city: dto.city,
        originLat: dto.originLat,
        originLng: dto.originLng,
        destinationLat: dto.destinationLat,
        destinationLng: dto.destinationLng,
        straightLineKm: this.money(straightLineKm),
        distanceKm: this.money(distanceKm),
        durationMinutes: normalMinutes,
        trafficDurationMinutes,
        trafficLevel,
        geometry: {
          type: 'LineString',
          coordinates: [
            [dto.originLng, dto.originLat],
            [dto.destinationLng, dto.destinationLat],
          ],
        } as any,
        metadata: {
          routeFactor: 1.25,
          fallbackAverageSpeedKmh: 25,
          note:
            'Estimacion local. Con proveedor real se sustituye por distancia, ETA y polilinea de calles.',
        } as any,
      },
    });
  }

  private fareRecommendation(
    distanceKm: number,
    trafficMinutes: number,
    policy: {
      baseFare: number;
      perKm: number;
      perMinuteTarget: number;
      minimumFare: number;
      minimumAllowedRatio: number;
      reasonableOfferRatio: number;
      fastMatchRatio: number;
    },
    pickupDistanceKm = 0,
    freePickupKm = 0,
    pickupPerKm = 0,
  ) {
    const byDistance = distanceKm * policy.perKm;
    const byTime = trafficMinutes * policy.perMinuteTarget;
    const pickupCharge =
      Math.max(0, pickupDistanceKm - freePickupKm) * pickupPerKm;

    const recommendedFare = this.money(
      Math.max(
        policy.minimumFare,
        policy.baseFare + Math.max(byDistance, byTime) + pickupCharge,
      ),
    );

    const minimumAllowedFare = this.money(
      Math.max(
        policy.minimumFare,
        recommendedFare * policy.minimumAllowedRatio,
      ),
    );

    const reasonableFare = this.money(
      Math.max(
        minimumAllowedFare,
        recommendedFare * policy.reasonableOfferRatio,
      ),
    );

    const fastMatchFare = this.money(
      recommendedFare * policy.fastMatchRatio,
    );

    return {
      byDistance: this.money(byDistance),
      byTime: this.money(byTime),
      pickupCharge: this.money(pickupCharge),
      recommendedFare,
      minimumAllowedFare,
      reasonableFare,
      fastMatchFare,
    };
  }

  private acceptanceEstimate(
    offer: number,
    recommendation: {
      recommendedFare: number;
      minimumAllowedFare: number;
      reasonableFare: number;
      fastMatchFare: number;
    },
    pickupDistanceKm = 0,
  ) {
    let score: number;
    let level: string;
    let message: string;

    if (offer >= recommendation.fastMatchFare) {
      score = 92;
      level = 'VERY_HIGH';
      message = 'Oferta en zona de emparejamiento rapido.';
    } else if (offer >= recommendation.recommendedFare) {
      score = 82;
      level = 'HIGH';
      message = 'Oferta cercana o superior al precio recomendado.';
    } else if (offer >= recommendation.reasonableFare) {
      score = 65;
      level = 'MEDIUM_HIGH';
      message = 'Oferta razonable; puede requerir algo de espera.';
    } else if (offer >= recommendation.minimumAllowedFare) {
      score = 40;
      level = 'MEDIUM_LOW';
      message =
        'Oferta baja. Yaleka recomienda aumentarla para facilitar aceptacion.';
    } else {
      score = 10;
      level = 'VERY_LOW';
      message = 'Oferta por debajo del rango permitido.';
    }

    const pickupPenalty = Math.min(25, Math.max(0, pickupDistanceKm - 2) * 4);
    score = Math.max(1, Math.round(score - pickupPenalty));

    return {
      score,
      level,
      message,
      source: 'HEURISTIC_MVP',
      disclaimer:
        'Es una recomendacion heuristica, no una probabilidad estadistica real. Mejorara con datos historicos de aceptacion.',
    };
  }

  async createNegotiation(dto: CreateNegotiationDto) {
    await this.throttle(
      'CREATE_NEGOTIATION',
      dto.passengerUserId,
      10,
      600,
    );

    if (dto.clientRequestId) {
      const duplicate =
        await this.prisma.mobilityNegotiationRequest.findUnique({
          where: { clientRequestId: dto.clientRequestId },
        });
      if (duplicate) return this.getNegotiation(duplicate.id);
    }

    const [route, policy] = await Promise.all([
      this.estimateRoute(dto),
      this.activePolicy(dto.city),
    ]);

    const recommendation = this.fareRecommendation(
      route.distanceKm,
      route.trafficDurationMinutes,
      policy,
      0,
      policy.freePickupKm,
      policy.pickupPerKm,
    );

    const passengerOffer = this.money(
      dto.proposedFare ?? recommendation.recommendedFare,
    );

    if (passengerOffer < recommendation.minimumAllowedFare) {
      throw new BadRequestException({
        message: 'La tarifa propuesta es demasiado baja.',
        minimumAllowedFare: recommendation.minimumAllowedFare,
        reasonableFare: recommendation.reasonableFare,
        recommendedFare: recommendation.recommendedFare,
        fastMatchFare: recommendation.fastMatchFare,
      });
    }

    const request = await this.prisma.mobilityNegotiationRequest.create({
      data: {
        clientRequestId: dto.clientRequestId,
        passengerUserId: dto.passengerUserId,
        routeEstimateId: route.id,
        originAddress: dto.originAddress,
        originLat: dto.originLat,
        originLng: dto.originLng,
        destinationAddress: dto.destinationAddress,
        destinationLat: dto.destinationLat,
        destinationLng: dto.destinationLng,
        distanceKm: route.distanceKm,
        durationMinutes: route.durationMinutes,
        trafficMinutes: route.trafficDurationMinutes,
        recommendedFare: recommendation.recommendedFare,
        minimumAllowedFare: recommendation.minimumAllowedFare,
        reasonableFare: recommendation.reasonableFare,
        fastMatchFare: recommendation.fastMatchFare,
        passengerOffer,
        expiresAt: new Date(Date.now() + 10 * 60 * 1000),
      },
    });

    const proposal = await this.prisma.mobilityFareProposal.create({
      data: {
        requestId: request.id,
        proposerType: 'PASSENGER',
        proposerId: dto.passengerUserId,
        amount: passengerOffer,
        status: 'ACTIVE',
        note: 'Oferta inicial del pasajero',
      },
    });

    await this.audit(
      request.id,
      'PASSENGER',
      dto.passengerUserId,
      'NEGOTIATION_CREATED',
      proposal.id,
      {
        passengerOffer,
        recommendedFare: recommendation.recommendedFare,
      },
    );

    return this.getNegotiation(request.id);
  }

  private async ensureOpenRequest(id: string) {
    const request = await this.prisma.mobilityNegotiationRequest.findUnique({
      where: { id },
    });
    if (!request) throw new NotFoundException('Negociacion no encontrada.');

    if (request.status !== 'OPEN') {
      throw new ConflictException(
        `La negociacion ya no esta abierta: ${request.status}.`,
      );
    }

    if (request.expiresAt < new Date()) {
      await this.prisma.mobilityNegotiationRequest.update({
        where: { id },
        data: { status: 'EXPIRED' },
      });
      throw new ConflictException('La negociacion ya vencio.');
    }

    return request;
  }

  async getNegotiation(id: string) {
    const request = await this.prisma.mobilityNegotiationRequest.findUnique({
      where: { id },
    });
    if (!request) throw new NotFoundException('Negociacion no encontrada.');

    const [proposals, audit, route] = await Promise.all([
      this.prisma.mobilityFareProposal.findMany({
        where: { requestId: id },
        orderBy: { createdAt: 'asc' },
      }),
      this.prisma.mobilityNegotiationAudit.findMany({
        where: { requestId: id },
        orderBy: { createdAt: 'asc' },
      }),
      request.routeEstimateId
        ? this.prisma.mobilityRouteEstimate.findUnique({
            where: { id: request.routeEstimateId },
          })
        : null,
    ]);

    return {
      request,
      route,
      recommendation: {
        minimumAllowedFare: request.minimumAllowedFare,
        reasonableFare: request.reasonableFare,
        recommendedFare: request.recommendedFare,
        fastMatchFare: request.fastMatchFare,
        passengerOffer: request.passengerOffer,
        acceptance:
          this.acceptanceEstimate(request.passengerOffer, request),
      },
      proposals,
      audit,
    };
  }

  async recommendation(id: string) {
    const request = await this.prisma.mobilityNegotiationRequest.findUnique({
      where: { id },
    });
    if (!request) throw new NotFoundException('Negociacion no encontrada.');

    const bands = [
      {
        label: 'BAJA',
        from: request.minimumAllowedFare,
        to: this.money(request.reasonableFare - 0.01),
        explanation: 'Puede tardar mas o recibir contraofertas.',
      },
      {
        label: 'RAZONABLE',
        from: request.reasonableFare,
        to: this.money(request.recommendedFare - 0.01),
        explanation: 'Mejor equilibrio entre ahorro y aceptacion.',
      },
      {
        label: 'RECOMENDADA',
        from: request.recommendedFare,
        to: this.money(request.fastMatchFare - 0.01),
        explanation: 'Zona recomendada por Yaleka.',
      },
      {
        label: 'RAPIDA',
        from: request.fastMatchFare,
        to: null,
        explanation: 'Mayor facilidad de emparejamiento.',
      },
    ];

    return {
      requestId: id,
      distanceKm: request.distanceKm,
      trafficMinutes: request.trafficMinutes,
      currentOffer: request.passengerOffer,
      minimumAllowedFare: request.minimumAllowedFare,
      reasonableFare: request.reasonableFare,
      recommendedFare: request.recommendedFare,
      fastMatchFare: request.fastMatchFare,
      currentAcceptanceEstimate: this.acceptanceEstimate(
        request.passengerOffer,
        request,
      ),
      bands,
      pricingPrinciple:
        'Yaleka usa el mayor entre componente por distancia y componente por tiempo, mas base y eventual compensacion de aproximacion.',
    };
  }

  // YALEKA_PHASE8_PATCH_V1
  async passengerOffer(id: string, dto: PassengerOfferDto) {
    const request = await this.ensureOpenRequest(id);
    if (request.passengerUserId !== dto.passengerUserId) {
      throw new BadRequestException('El pasajero no corresponde a esta negociacion.');
    }
    if (dto.clientRequestId) {
      const prior = await this.prisma.mobilityFareProposal.findUnique({
        where: { clientRequestId: dto.clientRequestId },
      });
      if (prior) {
        if (prior.requestId !== id || prior.proposerId !== dto.passengerUserId || prior.proposerType !== 'PASSENGER') {
          throw new ConflictException('Clave de idempotencia utilizada en otra operacion.');
        }
        return { proposal: prior, idempotent: true };
      }
    }
    const amount = this.money(dto.amount);
    if (!Number.isFinite(amount) || amount < request.minimumAllowedFare) {
      throw new BadRequestException({
        message: 'Oferta invalida o por debajo del minimo permitido.',
        minimumAllowedFare: request.minimumAllowedFare,
        reasonableFare: request.reasonableFare,
        recommendedFare: request.recommendedFare,
      });
    }
    await this.throttle('PASSENGER_OFFER', dto.passengerUserId, 15, 600);
    const proposal = await this.prisma.$transaction(async (tx) => {
      const claim = await tx.mobilityNegotiationRequest.updateMany({
        where: { id, status: 'OPEN', expiresAt: { gt: new Date() } },
        data: { passengerOffer: amount },
      });
      if (claim.count !== 1) throw new ConflictException('La negociacion cambio o vencio. Actualiza la pantalla.');
      const created = await tx.mobilityFareProposal.create({
        data: { clientRequestId: dto.clientRequestId, requestId: id,
          proposerType: 'PASSENGER', proposerId: dto.passengerUserId,
          amount, status: 'ACTIVE', note: dto.note },
      });
      await tx.mobilityNegotiationAudit.create({
        data: { requestId: id, actorType: 'PASSENGER', actorId: dto.passengerUserId,
          action: 'PASSENGER_OFFER_CHANGED', proposalId: created.id,
          metadata: { amount } as any },
      });
      return created;
    });
    return { proposal,
      acceptance: this.acceptanceEstimate(amount, request),
      recommendation: { reasonableFare: request.reasonableFare,
        recommendedFare: request.recommendedFare,
        fastMatchFare: request.fastMatchFare } };
  }

  async driverCounter(id: string, dto: DriverCounterDto) {
    const request = await this.ensureOpenRequest(id);
    if (dto.clientRequestId) {
      const prior = await this.prisma.mobilityFareProposal.findUnique({where:{clientRequestId:dto.clientRequestId}});
      if (prior) {
        if (prior.requestId !== id || prior.driverId !== dto.driverId || prior.proposerType !== 'DRIVER') {
          throw new ConflictException('Clave de idempotencia utilizada en otra operacion.');
        }
        return {proposal:prior,idempotent:true};
      }
    }
    const driver = await this.prisma.mobilityDriver.findUnique({where:{id:dto.driverId}});
    if (!driver || driver.status !== 'APPROVED' || !driver.isAvailable)
      throw new BadRequestException('Conductor no aprobado o no disponible.');
    const route = request.routeEstimateId
      ? await this.prisma.mobilityRouteEstimate.findUnique({where:{id:request.routeEstimateId}})
      : null;
    const policy = await this.activePolicy(route?.city ?? undefined);
    const maxAllowed = this.money(request.recommendedFare * policy.maxDriverCounterRatio);
    const amount = this.money(dto.amount);
    if (!Number.isFinite(amount) || amount < request.minimumAllowedFare || amount > maxAllowed) {
      throw new BadRequestException({message:'Contraoferta fuera del rango permitido.',
        minimumAllowedFare:request.minimumAllowedFare, maxAllowed});
    }
    const activeCount = await this.prisma.mobilityFareProposal.count({
      where:{requestId:id,driverId:dto.driverId,status:'ACTIVE'},
    });
    if (activeCount >= 5) throw new HttpException('Demasiadas contraofertas activas.',HttpStatus.TOO_MANY_REQUESTS);
    const pickupDistanceKm = driver.currentLat !== null && driver.currentLng !== null
      ? this.money(this.haversineKm(driver.currentLat,driver.currentLng,request.originLat,request.originLng)*1.2) : 0;
    await this.throttle('DRIVER_COUNTER',dto.driverId,30,600);
    const proposal = await this.prisma.$transaction(async (tx) => {
      const claim=await tx.mobilityNegotiationRequest.updateMany({
        where:{id,status:'OPEN',expiresAt:{gt:new Date()}},data:{updatedAt:new Date()},
      });
      if (claim.count !== 1) throw new ConflictException('Negociacion ya cerrada o vencida.');
      const created=await tx.mobilityFareProposal.create({
        data:{clientRequestId:dto.clientRequestId,requestId:id,proposerType:'DRIVER',
          proposerId:dto.driverId,driverId:dto.driverId,amount,
          etaMinutes:dto.etaMinutes,status:'ACTIVE',note:dto.note},
      });
      await tx.mobilityNegotiationAudit.create({data:{requestId:id,actorType:'DRIVER',
        actorId:dto.driverId,action:'DRIVER_COUNTER_CREATED',proposalId:created.id,
        metadata:{amount,pickupDistanceKm} as any}});
      return created;
    });
    return {proposal,passengerView:{amount,etaMinutes:dto.etaMinutes,
      differenceVsRecommended:this.money(amount-request.recommendedFare)},
      driverContext:{pickupDistanceKm,acceptanceEstimate:this.acceptanceEstimate(
        request.passengerOffer,request,pickupDistanceKm)}};
  }

  async candidates(id: string, dto: CandidateSearchDto) {
    const request = await this.ensureOpenRequest(id);
    const radiusKm = dto.radiusKm ?? 8;
    const limit = dto.limit ?? 15;
    const route = request.routeEstimateId
      ? await this.prisma.mobilityRouteEstimate.findUnique({
          where: { id: request.routeEstimateId },
        })
      : null;
    const policy = await this.activePolicy(route?.city ?? undefined);

    const drivers = await this.prisma.mobilityDriver.findMany({
      where: {
        status: 'APPROVED',
        isAvailable: true,
        currentLat: { not: null },
        currentLng: { not: null },
      },
      orderBy: [{ rating: 'desc' }, { totalTrips: 'desc' }],
      take: 100,
    });

    const ranked = drivers
      .map((driver) => {
        const pickupDistanceKm = this.money(
          this.haversineKm(
            driver.currentLat!,
            driver.currentLng!,
            request.originLat,
            request.originLng,
          ) * 1.2,
        );

        const pickupEtaMinutes = Math.max(
          1,
          Math.round((pickupDistanceKm / 22) * 60),
        );

        const fareWithPickup = this.fareRecommendation(
          request.distanceKm,
          request.trafficMinutes,
          policy,
          pickupDistanceKm,
          policy.freePickupKm,
          policy.pickupPerKm,
        );

        const acceptance = this.acceptanceEstimate(
          request.passengerOffer,
          fareWithPickup,
          pickupDistanceKm,
        );

        const qualityBonus =
          Math.min(8, Math.max(0, (driver.rating - 4) * 5)) +
          Math.min(5, driver.totalTrips / 20);

        const matchScore = Math.max(
          1,
          Math.min(100, Math.round(acceptance.score + qualityBonus)),
        );

        return {
          driverId: driver.id,
          displayName: driver.displayName,
          rating: driver.rating,
          totalTrips: driver.totalTrips,
          pickupDistanceKm,
          pickupEtaMinutes,
          currentPassengerOffer: request.passengerOffer,
          suggestedFareForThisDriver: fareWithPickup.recommendedFare,
          fastMatchFareForThisDriver: fareWithPickup.fastMatchFare,
          acceptanceEstimate: acceptance,
          matchScore,
        };
      })
      .filter((x) => x.pickupDistanceKm <= radiusKm)
      .sort((a, b) => b.matchScore - a.matchScore)
      .slice(0, limit);

    return {
      requestId: id,
      radiusKm,
      count: ranked.length,
      candidates: ranked,
      note:
        'El score es heuristico. Cuando Yaleka tenga historial suficiente se reemplaza por modelo calibrado con aceptaciones reales.',
    };
  }


  async driverAccept(id: string, dto: DriverAcceptDto) {
    if (dto.clientRequestId) {
      const prior=await this.prisma.mobilityFareProposal.findUnique({where:{clientRequestId:dto.clientRequestId}});
      if (prior) {
        if (prior.requestId!==id || prior.driverId!==dto.driverId || prior.proposerType!=='DRIVER')
          throw new ConflictException('Clave de idempotencia utilizada en otra operacion.');
        return {request:await this.prisma.mobilityNegotiationRequest.findUnique({where:{id}}),
          proposal:prior,idempotent:true};
      }
    }
    await this.ensureOpenRequest(id);
    const driver=await this.prisma.mobilityDriver.findUnique({where:{id:dto.driverId}});
    if (!driver || driver.status!=='APPROVED' || !driver.isAvailable)
      throw new BadRequestException('Conductor no aprobado o no disponible.');
    await this.throttle('DRIVER_ACCEPT',dto.driverId,20,600);
    const proposal=await this.prisma.$transaction(async (tx) => {
      const claim=await tx.mobilityNegotiationRequest.updateMany({
        where:{id,status:'OPEN',expiresAt:{gt:new Date()}},data:{status:'MATCHED'},
      });
      if(claim.count!==1) throw new ConflictException('Este viaje ya fue tomado o vencio.');
      const current=await tx.mobilityNegotiationRequest.findUnique({where:{id}});
      if(!current) throw new NotFoundException('Negociacion no encontrada.');
      const created=await tx.mobilityFareProposal.create({data:{
        clientRequestId:dto.clientRequestId,requestId:id,proposerType:'DRIVER',
        proposerId:dto.driverId,driverId:dto.driverId,amount:current.passengerOffer,
        etaMinutes:dto.etaMinutes,status:'ACCEPTED',
        note:dto.note ?? 'Conductor acepta la oferta actual del pasajero',
      }});
      await tx.mobilityFareProposal.updateMany({where:{requestId:id,id:{not:created.id},status:'ACTIVE'},
        data:{status:'REJECTED'}});
      await tx.mobilityNegotiationRequest.update({where:{id},
        data:{selectedProposalId:created.id,agreedFare:created.amount}});
      await tx.mobilityNegotiationAudit.create({data:{requestId:id,actorType:'DRIVER',
        actorId:dto.driverId,action:'PASSENGER_OFFER_ACCEPTED_BY_DRIVER',proposalId:created.id,
        metadata:{agreedFare:created.amount,etaMinutes:dto.etaMinutes} as any}});
      return created;
    });
    return {...(await this.getNegotiation(id)),acceptedBy:'DRIVER',driverId:dto.driverId,
      proposal,nextStep:'Crear viaje base autorizado a partir de acuerdo; no se crea automaticamente.'};
  }

  async acceptProposal(id: string, proposalId: string, dto: AcceptProposalDto) {
    const request=await this.prisma.mobilityNegotiationRequest.findUnique({where:{id}});
    if(!request) throw new NotFoundException('Negociacion no encontrada.');
    if(request.passengerUserId!==dto.passengerUserId)
      throw new BadRequestException('El pasajero no corresponde a esta negociacion.');
    if(request.status==='MATCHED' && request.selectedProposalId===proposalId)
      return this.getNegotiation(id);
    if(request.status!=='OPEN' || request.expiresAt<=new Date())
      throw new ConflictException('La negociacion ya cerro o vencio.');
    const proposal=await this.prisma.mobilityFareProposal.findUnique({where:{id:proposalId}});
    if(!proposal || proposal.requestId!==id || proposal.status!=='ACTIVE' ||
       proposal.proposerType!=='DRIVER' || !proposal.driverId)
      throw new BadRequestException('Selecciona una contraoferta valida de un conductor.');
    const driver=await this.prisma.mobilityDriver.findUnique({where:{id:proposal.driverId}});
    if(!driver || driver.status!=='APPROVED' || !driver.isAvailable)
      throw new ConflictException('El conductor ya no esta disponible.');
    await this.prisma.$transaction(async(tx)=>{
      const claim=await tx.mobilityNegotiationRequest.updateMany({
        where:{id,status:'OPEN',expiresAt:{gt:new Date()}},data:{status:'MATCHED'},
      });
      if(claim.count!==1) throw new ConflictException('Otro conductor fue seleccionado o vencio el tiempo.');
      const chosen=await tx.mobilityFareProposal.updateMany({
        where:{id:proposalId,requestId:id,status:'ACTIVE',proposerType:'DRIVER'},
        data:{status:'ACCEPTED'},
      });
      if(chosen.count!==1) throw new ConflictException('Contraoferta ya no disponible.');
      await tx.mobilityFareProposal.updateMany({where:{requestId:id,id:{not:proposalId},status:'ACTIVE'},
        data:{status:'REJECTED'}});
      await tx.mobilityNegotiationRequest.update({where:{id},
        data:{selectedProposalId:proposalId,agreedFare:proposal.amount}});
      await tx.mobilityNegotiationAudit.create({data:{requestId:id,actorType:'PASSENGER',
        actorId:dto.passengerUserId,action:'PROPOSAL_ACCEPTED',proposalId,
        metadata:{agreedFare:proposal.amount,driverId:proposal.driverId} as any}});
    });
    return {...(await this.getNegotiation(id)),nextStep:
      'Crear viaje base autorizado a partir de acuerdo; no se crea automaticamente.'};
  }


}