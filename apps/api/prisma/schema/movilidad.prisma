  updatedAt   DateTime  @updatedAt

  @@index([driverId, active])
  @@index([vehicleId, active])
  @@map("mobility_vehicle_trackers")
}

model MobilityLostItemCase {
  id              String    @id @default(uuid())
  tripId          String
  passengerUserId String
