model MobilitySafeRide {
  id                 String    @id @default(uuid())
  driverId           String
  passengerUserId    String?
  vehicleId          String
  originAddress      String
  originLat          Float?
  originLng          Float?
  destinationAddress String
  destinationLat     Float?
  destinationLng     Float?
  status             String    @default("CREATED")
  safetyPinHash      String
  shareToken         String?   @unique
  shareExpiresAt     DateTime?
  lastLat            Float?
  lastLng            Float?
  lastLocationAt     DateTime?
  notes              String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([driverId, status, createdAt])
  @@index([passengerUserId, createdAt])
  @@map("mobility_safe_rides")
}

model MobilitySafeRideTrace {
  id             String   @id @default(uuid())
  safeRideId     String
  lat            Float
  lng            Float
  accuracyMeters Float?
  source         String   @default("PHONE")
  isBackground   Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([safeRideId, createdAt])
  @@map("mobility_safe_ride_traces")
}

model MobilitySafeRideIncident {
  id         String    @id @default(uuid())
  safeRideId String
  type       String
  severity   String    @default("HIGH")
  silentMode Boolean   @default(false)
  status     String    @default("OPEN")
  lat        Float?
  lng        Float?
  notes      String?
  metadata   Json?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([safeRideId, status, createdAt])
  @@map("mobility_safe_ride_incidents")
}

model MobilityNegotiationPolicy {
  id                    String   @id @default(uuid())
  name                  String
  city                  String?
  country               String   @default("MX")
  isActive              Boolean  @default(true)
  baseFare              Float    @default(15)
  perKm                 Float    @default(10)
  perMinuteTarget       Float    @default(3)
  minimumFare           Float    @default(50)
  minimumAllowedRatio   Float    @default(0.75)
  reasonableOfferRatio  Float    @default(0.85)
  fastMatchRatio        Float    @default(1.05)
  maxDriverCounterRatio Float    @default(1.25)
  platformPercent       Float    @default(8)
  freePickupKm          Float    @default(2)
  pickupPerKm           Float    @default(4)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([isActive, city])
  @@map("mobility_negotiation_policies")
}

model MobilityRouteEstimate {
  id                     String   @id @default(uuid())
  provider               String   @default("FALLBACK")
  city                   String?
  originLat              Float
  originLng              Float
  destinationLat         Float
  destinationLng         Float
  straightLineKm         Float
  distanceKm             Float
  durationMinutes        Int
  trafficDurationMinutes Int
  trafficLevel           String   @default("NORMAL")
  geometry               Json?
  metadata               Json?
  createdAt              DateTime @default(now())

  @@index([provider, createdAt])
  @@map("mobility_route_estimates")
}

model MobilityNegotiationRequest {
  id                 String   @id @default(uuid())
  clientRequestId    String?  @unique
  passengerUserId    String
  routeEstimateId    String?
  originAddress      String
  originLat          Float
  originLng          Float
  destinationAddress String
  destinationLat     Float
  destinationLng     Float
  distanceKm         Float
  durationMinutes    Int
  trafficMinutes     Int
  recommendedFare    Float
  minimumAllowedFare Float
  reasonableFare     Float
  fastMatchFare      Float
  passengerOffer     Float
  status             String   @default("OPEN")
  selectedProposalId String?
  agreedFare         Float?
  currency           String   @default("MXN")
  expiresAt          DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([passengerUserId, status, createdAt])
  @@index([status, expiresAt])
  @@map("mobility_negotiation_requests")
}

model MobilityFareProposal {
  id              String   @id @default(uuid())
  clientRequestId String?  @unique
  requestId       String
  proposerType    String
  proposerId      String
  driverId        String?
  amount          Float
  etaMinutes      Int?
  status          String   @default("ACTIVE")
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([requestId, status, createdAt])
  @@index([driverId, status, createdAt])
  @@map("mobility_fare_proposals")
}

model MobilityNegotiationAudit {
  id         String   @id @default(uuid())
  requestId  String
  actorType  String
  actorId    String?
  action     String
  proposalId String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([requestId, createdAt])
  @@index([actorType, actorId, createdAt])
  @@map("mobility_negotiation_audit")
}

model MobilityRequestThrottle {
  id        String   @id @default(uuid())
  action    String
  actorId   String
  createdAt DateTime @default(now())

  @@index([action, actorId, createdAt])
  @@map("mobility_request_throttle")
}

model MobilityExperiencePreference {
  id                  String   @id @default(uuid())
  subjectType         String
  subjectId           String
  language            String   @default("es-MX")
  voiceEnabled        Boolean  @default(true)
  spokenConfirmations Boolean  @default(true)
  fareMode            String   @default("BALANCED")
  searchRadiusKm      Float    @default(8)
  simpleMode          Boolean  @default(true)
  largeControls       Boolean  @default(false)
  reduceMotion        Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([subjectType, subjectId])
  @@index([subjectType, subjectId])
  @@map("mobility_experience_preferences")
}

model MobilityVoiceCommand {
  id                   String    @id @default(uuid())
  subjectType          String
  subjectId            String
  rawText              String
  normalizedText       String
  intent               String
  confidence           Float     @default(0)
  requiresConfirmation Boolean   @default(false)
  status               String    @default("INTERPRETED")
  requestId            String?
  proposalId           String?
  amount               Float?
  payload              Json?
  result               Json?
  expiresAt            DateTime
  executedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([subjectType, subjectId, createdAt])
  @@index([status, expiresAt])
  @@index([requestId, createdAt])
  @@map("mobility_voice_commands")
}

model MobilityNegotiationContext {
  id                      String   @id @default(uuid())
  requestId               String   @unique
  city                    String?
  requestedMode           String   @default("BALANCED")
  createdByVoice          Boolean  @default(false)
  preferredSearchRadiusKm Float    @default(8)
  source                  String   @default("YALEKA")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([city, createdAt])
  @@map("mobility_negotiation_contexts")
}

model MobilitySavedPlace {
  id         String    @id @default(uuid())
  userId     String
  label      String
  kind       String    @default("CUSTOM")
  address    String
  lat        Float
  lng        Float
  visits     Int       @default(0)
  score      Float     @default(0)
