// Movilidad

enum MobilityDriverStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum MobilityVehicleStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum MobilityTripStatus {
  REQUESTED
  NEGOTIATING
  DRIVER_EN_ROUTE
  DRIVER_ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MobilityOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model MobilityDriver {
  id          String               @id @default(uuid())
  displayName String
  phone       String
  status      MobilityDriverStatus @default(PENDING_REVIEW)
  isAvailable Boolean              @default(false)
  rating      Float                @default(5)
  totalTrips  Int                  @default(0)

  currentLat     Float?
  currentLng     Float?
  lastLocationAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  vehicles MobilityVehicle[]
  offers   MobilityOffer[]
  trips    MobilityTrip[]

  @@index([status, isAvailable])
  @@index([currentLat, currentLng])
  @@map("mobility_drivers")
}

model MobilityVehicle {
  id       String                @id @default(uuid())
  brand    String
  model    String
  year     Int
  color    String
  plate    String                @unique
  status   MobilityVehicleStatus @default(PENDING_REVIEW)
  isActive Boolean               @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driverId String
  driver   MobilityDriver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  offers MobilityOffer[]
  trips  MobilityTrip[]

  @@index([driverId])
  @@index([status, isActive])
  @@map("mobility_vehicles")
}

model MobilityTrip {
  id String @id @default(uuid())

  originAddress      String
  originLat          Float
  originLng          Float
  destinationAddress String
  destinationLat     Float
  destinationLng     Float

  passengerSuggestedFare Float
  agreedFare             Float?
  finalFare              Float?

  status    MobilityTripStatus @default(REQUESTED)
  safetyPin String
  notes     String?

  assignedAt         DateTime?
  driverArrivedAt    DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelledBy        String?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passengerUserId String
  passenger       User   @relation("MobilityPassenger", fields: [passengerUserId], references: [id], onDelete: Restrict)

  driverId String?
  driver   MobilityDriver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  vehicleId String?
  vehicle   MobilityVehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  acceptedOfferId String?        @unique
  acceptedOffer   MobilityOffer? @relation("AcceptedMobilityOffer", fields: [acceptedOfferId], references: [id], onDelete: SetNull)

  offers MobilityOffer[]     @relation("MobilityTripOffers")
  events MobilityTripEvent[]

  @@index([passengerUserId, status])
  @@index([driverId, status])
  @@index([status, createdAt])
  @@map("mobility_trips")
}

model MobilityOffer {
  id         String              @id @default(uuid())
  amount     Float
  etaMinutes Int
  status     MobilityOfferStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tripId String
  trip   MobilityTrip @relation("MobilityTripOffers", fields: [tripId], references: [id], onDelete: Cascade)

  driverId String
  driver   MobilityDriver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  vehicleId String
  vehicle   MobilityVehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  acceptedFor MobilityTrip? @relation("AcceptedMobilityOffer")

  @@index([tripId, status])
  @@index([driverId, status])
  @@map("mobility_offers")
}

model MobilityTripEvent {
  id        String   @id @default(uuid())
  type      String
  actorType String
  actorId   String?
  lat       Float?
  lng       Float?
  metadata  Json?
  createdAt DateTime @default(now())

  tripId String
  trip   MobilityTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, createdAt])
  @@index([type])
  @@map("mobility_trip_events")
}

model MobilityLocationTrace {
  id             String   @id @default(uuid())
  tripId         String
  actorType      String
  actorId        String
  source         String   @default("PHONE")
  lat            Float
  lng            Float
  accuracyMeters Float?
  speedKmh       Float?
  batteryPct     Int?
  isBackground   Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([tripId, createdAt])
  @@index([actorType, actorId, createdAt])
  @@map("mobility_location_traces")
}

model MobilityCancellationCase {
  id                       String    @id @default(uuid())
  tripId                   String    @unique
  requestedByType          String
  requestedById            String
  reason                   String?
  decision                 String    @default("PENDING")
  chargePassenger          Boolean   @default(false)
  compensateDriver         Boolean   @default(false)
  passengerChargeAmount    Float     @default(0)
  driverCompensationAmount Float     @default(0)
  driverDistanceToPickupKm Float?
  driverWaitSeconds        Int?
  routeDeviationKm         Float?
  evidence                 Json?
  reviewedAt               DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([decision, createdAt])
  @@map("mobility_cancellation_cases")
}

model MobilitySafetyIncident {
  id            String    @id @default(uuid())
  tripId        String?
  driverId      String?
  userId        String?
  type          String
  severity      String    @default("HIGH")
  status        String    @default("OPEN")
  triggerSource String    @default("APP")
  silentMode    Boolean   @default(true)
  lat           Float?
  lng           Float?
  notes         String?
  metadata      Json?
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?

  @@index([status, createdAt])
  @@index([driverId, createdAt])
  @@map("mobility_safety_incidents")
}

model MobilityTrustedContact {
  id                String   @id @default(uuid())
  ownerUserId       String
  name              String
  phone             String
  priority          Int      @default(1)
  notifyOnTrip      Boolean  @default(false)
  notifyOnEmergency Boolean  @default(true)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([ownerUserId, isActive])
  @@map("mobility_trusted_contacts")
}

model MobilityVehicleTracker {
  id          String    @id @default(uuid())
  driverId    String
  vehicleId   String?
  deviceLabel String
  provider    String?
  deviceUid   String?
  active      Boolean   @default(true)
  monthlyCost Float?
  lastLat     Float?
  lastLng     Float?
  lastSeenAt  DateTime?
