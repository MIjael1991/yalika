  auditEvents     ClinicalAuditEvent[]

  @@map("clinical_profiles")
}

model ClinicalDocument {
  id                 String   @id @default(uuid())
  profileId          String
  profile            ClinicalProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  title              String
  documentType       String
  originalName       String
  mimeType           String
  byteSize           Int
  sha256             String
  storageKey         String
  source             String   @default("PATIENT_PROVIDED")
  verificationStatus String   @default("UNVERIFIED")
  clinicalDate       DateTime?
  createdByUserId    String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  versions      ClinicalDocumentVersion[]
  prescriptions ClinicalPrescription[]

  @@unique([profileId, sha256])
  @@index([profileId, clinicalDate])
  @@index([profileId, createdAt])
  @@map("clinical_documents")
}

model ClinicalDocumentVersion {
  id            String   @id @default(uuid())
  documentId    String
  document      ClinicalDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  versionNumber Int
  storageKey    String
  sha256        String
  mimeType      String
  byteSize      Int
  kind          String   @default("ORIGINAL")
