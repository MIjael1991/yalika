// YALEKA_CLINICAL_R30_TRUST_BEGIN
model ClinicalCareOrganization {
  id                             String   @id @default(uuid())
  ownerUserId                    String
  organizationType               String
  displayName                    String
  legalName                      String?
  rfc                            String?
  phone                          String?
  email                          String?
  addressLine1                   String?
  addressLine2                   String?
  neighborhood                   String?
  municipality                   String?
  state                          String?
  postalCode                     String?
  sanitaryNoticeNumber           String?
  healthAuthorizationNumber      String?
  responsibleName                String?
  responsibleRole                String?
  responsibleProfessionalLicense String?
  verificationStatus             String   @default("PENDING")
  verificationSource             String?
  verificationNotes              String?
  verifiedAt                     DateTime?
  verifiedById                   String?
  active                         Boolean  @default(true)
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  memberships   ClinicalOrganizationProfessional[]
  verifications ClinicalOrganizationVerification[]

  @@index([ownerUserId, active])
  @@index([verificationStatus, organizationType])
  @@map("clinical_care_organizations")
}

model ClinicalProfessionalProfile {
  id                        String   @id @default(uuid())
  userId                    String   @unique
  displayName               String
  professionalLicenseNumber String   @unique
  profession                String
  specialty                 String?
  specialistLicenseNumber   String?
  verificationStatus        String   @default("PENDING")
  canPrescribe              Boolean  @default(false)
  verificationSource        String?
  verificationReference     String?
  verificationNotes         String?
  verifiedAt                DateTime?
  verifiedById              String?
  active                    Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  memberships ClinicalOrganizationProfessional[]
  checks      ClinicalCredentialVerification[]

  @@index([verificationStatus, active])
  @@map("clinical_professional_profiles")
}

model ClinicalOrganizationProfessional {
  id                    String   @id @default(uuid())
  organizationId        String
  professionalProfileId String
  invitedById           String
  relationshipType      String   @default("AGREEMENT")
  status                String   @default("INVITED")
  startsAt              DateTime?
  endsAt                DateTime?
  acceptedAt            DateTime?
  endedAt               DateTime?
  endReason             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization ClinicalCareOrganization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professional ClinicalProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  @@unique([organizationId, professionalProfileId])
  @@index([professionalProfileId, status])
  @@index([organizationId, status])
  @@map("clinical_organization_professionals")
}

model ClinicalCredentialVerification {
  id                    String   @id @default(uuid())
  professionalProfileId String
  verificationType      String
  credentialValue       String
  source                String
  sourceReference       String?
  result                String
  notes                 String?
  checkedById           String
  checkedAt             DateTime @default(now())

  professional ClinicalProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  @@index([professionalProfileId, checkedAt])
  @@index([result, verificationType])
  @@map("clinical_credential_verifications")
}

model ClinicalOrganizationVerification {
  id               String   @id @default(uuid())
  organizationId   String
  verificationType String
  source           String
  sourceReference  String?
  result           String
  notes            String?
  checkedById      String
  checkedAt        DateTime @default(now())

  organization ClinicalCareOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, checkedAt])
  @@index([result, verificationType])
  @@map("clinical_organization_verifications")
}
// YALEKA_CLINICAL_R30_TRUST_END

// YALEKA_CLINICAL_R302_NETWORK_BEGIN
model ClinicalOrganizationLocation {
  id             String   @id @default(uuid())
  organizationId String   @unique
  latitude       Float
  longitude      Float
  accuracyMeters Float?
  source         String   @default("DEVICE")
  capturedById   String
  capturedAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([capturedById, capturedAt])
  @@map("clinical_organization_locations")
}

model ClinicalOrganizationEvidence {
  id             String    @id @default(uuid())
  organizationId String
  kind           String
  storageKey     String
  originalName   String
  mimeType       String
  sizeBytes      Int
  note           String?
  status         String    @default("SUBMITTED")
  createdById    String
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  @@index([organizationId, kind, deletedAt])
  @@index([createdById, createdAt])
  @@map("clinical_organization_evidence")
}

model ClinicalProfessionalInvitation {
  id               String   @id @default(uuid())
  organizationId   String
  invitedEmail     String
  invitedUserId    String?
  relationshipType String   @default("AGREEMENT")
  startsAt         DateTime?
  endsAt           DateTime?
  status           String   @default("INVITED")
  createdById      String
  acceptedAt       DateTime?
  membershipId     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([organizationId, status])
  @@index([invitedEmail, status])
  @@index([invitedUserId, status])
  @@map("clinical_professional_invitations")
}

model ClinicalOrganizationReviewSubmission {
  id             String   @id @default(uuid())
  organizationId String
  status         String   @default("SUBMITTED")
  snapshot       Json
  submittedById  String
  submittedAt    DateTime @default(now())

  @@index([organizationId, submittedAt])
  @@index([status, submittedAt])
  @@map("clinical_organization_review_submissions")
}
// YALEKA_CLINICAL_R302_NETWORK_END

// YALEKA_CLINICAL_R303_PATIENT_HOME_BEGIN
model ClinicalEmergencyProfile {
  id                          String   @id @default(uuid())
  clinicalProfileId           String   @unique
  bloodType                   String?
  bloodTypeSource             String   @default("PATIENT")
  bloodTypeConfirmationStatus String   @default("REPORTED")
  emergencyContactName        String?
  emergencyContactRelationship String?
  emergencyContactPhone       String?
  emergencyNotes              String?
  updatedById                 String
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@index([clinicalProfileId])
  @@map("clinical_emergency_profiles")
}

model ClinicalChronicCondition {
  id                 String   @id @default(uuid())
  clinicalProfileId  String
  conditionName      String
  diagnosedAt        DateTime?
  status             String   @default("ACTIVE")
  source             String   @default("PATIENT")
  confirmationStatus String   @default("REPORTED")
  notes              String?
  operationId        String?  @unique
  createdById        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([clinicalProfileId, status])
  @@index([clinicalProfileId, createdAt])
  @@map("clinical_chronic_conditions")
}
// YALEKA_CLINICAL_R303_PATIENT_HOME_END

// YALEKA_CLINICAL_R304_STRUCTURED_HISTORY_BEGIN
model ClinicalHealthEpisode {
  id                 String   @id @default(uuid())
  clinicalProfileId  String
  episodeType        String
  title              String
  bodyRegion         String?
  startedAt          DateTime?
  endedAt            DateTime?
  status             String   @default("ACTIVE")
  source             String   @default("PATIENT")
  confirmationStatus String   @default("REPORTED")
  notes              String?
  operationId        String?  @unique
  createdById        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([clinicalProfileId, status, startedAt])
  @@index([clinicalProfileId, episodeType])
  @@map("clinical_health_episodes")
}

model ClinicalHealthRecordLink {
  id                String   @id @default(uuid())
  clinicalProfileId String
  parentType        String
  parentId          String
  resourceType      String
  resourceId        String
  relationType      String   @default("RELATED")
  operationId       String?  @unique
  createdById       String
  createdAt         DateTime @default(now())

  @@unique([clinicalProfileId, parentType, parentId, resourceType, resourceId])
  @@index([clinicalProfileId, parentType, parentId])
  @@index([clinicalProfileId, resourceType, resourceId])
  @@map("clinical_health_record_links")
}

model ClinicalHealthPrivacySetting {
  id                            String   @id @default(uuid())
  clinicalProfileId             String
  resourceType                  String
  resourceId                    String
  sensitivity                   String   @default("STANDARD")
  shareWithVerifiedProfessional Boolean  @default(false)
  emergencyShare                Boolean  @default(false)
  updatedById                   String
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  @@unique([clinicalProfileId, resourceType, resourceId])
  @@index([clinicalProfileId, shareWithVerifiedProfessional])
  @@index([clinicalProfileId, emergencyShare])
  @@map("clinical_health_privacy_settings")
}

model ClinicalEmergencySharePolicy {
  id                       String   @id @default(uuid())
  clinicalProfileId        String   @unique
  includeBloodType         Boolean  @default(true)
  includeAllergies         Boolean  @default(true)
  includeCurrentMedications Boolean @default(true)
  includeEmergencyContact  Boolean  @default(true)
  includeSharedConditions  Boolean  @default(true)
  includeSharedProcedures  Boolean  @default(false)
  updatedById              String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("clinical_emergency_share_policies")
}

model ClinicalEmergencyRelayAuthorization {
  id                String   @id @default(uuid())
  clinicalProfileId String
  delegateUserId    String
  relationship      String?
  status            String   @default("ACTIVE")
  canRelay          Boolean  @default(true)
  expiresAt         DateTime?
  revokedAt         DateTime?
  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([clinicalProfileId, delegateUserId])
  @@index([delegateUserId, status])
  @@index([clinicalProfileId, status])
  @@map("clinical_emergency_relay_authorizations")
}

model ClinicalEmergencyRelayLink {
  id                String   @id @default(uuid())
  clinicalProfileId String
  authorizationId   String
  tokenHash         String   @unique
  tokenPrefix       String
  status            String   @default("ACTIVE")
  maxUses           Int      @default(10)
  usedCount         Int      @default(0)
  expiresAt         DateTime
  lastUsedAt        DateTime?
  createdByUserId   String
  createdAt         DateTime @default(now())

  @@index([clinicalProfileId, status, expiresAt])
  @@index([authorizationId, status])
  @@map("clinical_emergency_relay_links")
}
// YALEKA_CLINICAL_R304_STRUCTURED_HISTORY_END

model CommerceReservationPolicy {
  id String @id @default(uuid())

  enabled         Boolean @default(false)
  depositRequired Boolean @default(true)
  depositType     String  @default("fixed")
  depositValue    Float   @default(100)
  holdMinutes     Int     @default(15)
  activeDays      Int     @default(2)

  companyId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("commerce_reservation_policies")
}

model CommerceReservation {
  id String @id @default(uuid())

  reservationNumber String
  publicToken       String @unique @default(uuid())
  operationId       String

  status String @default("hold")
  source String @default("web")

  holdExpiresAt DateTime?
  pickupDeadline DateTime?

  depositRequiredAmount Float @default(0)
  depositAmount         Float @default(0)
  depositStatus         String @default("pending")
  depositMethod         String?
  depositReference      String?

  contactName  String
  contactPhone String
  deliveryMode String @default("arrange")
  notes        String?

  companyId String
  siteId    String?
  orderId   String?
  catalogId String?
  catalog CommerceCatalog? @relation(fields: [catalogId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?
  releasedAt  DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  items  CommerceReservationItem[]
  events CommerceReservationEvent[]

  @@unique([companyId, reservationNumber])
  @@unique([companyId, operationId])
  @@index([companyId, status])
  @@index([companyId, holdExpiresAt])
  @@index([companyId, pickupDeadline])
  @@index([catalogId])
  @@index([siteId])
  @@index([orderId])
  @@map("commerce_reservations")
}

model CommerceReservationItem {
  id String @id @default(uuid())

  productId String
  variantId String?
  quantity  Int

  unitPriceSnapshot   Float
  productNameSnapshot String
  variantSnapshot     String?

  createdAt  DateTime @default(now())
  releasedAt DateTime?

  reservationId String
  reservation   CommerceReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@index([productId, variantId])
  @@map("commerce_reservation_items")
}

model CommerceReservationEvent {
  id String @id @default(uuid())

  type    String
  note    String?
  actorId String?

  createdAt DateTime @default(now())

  reservationId String
  reservation   CommerceReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, createdAt])
  @@index([type])
  @@map("commerce_reservation_events")
}
