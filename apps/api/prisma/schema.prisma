generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        String   @id @default(uuid())
  name      String   @unique
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  site      Site?

  users             User[]
  roles             Role[]
  tasks             Task[]
  incidents         Incident[]
  events            Event[]
  workflows         Workflow[]
  experiences       Experience[]
  customers         Customer[]
  visits            Visit[]
  loyaltyPrograms   LoyaltyProgram[]
  customerRewards   CustomerReward[]
  productCategories ProductCategory[]
  products          Product[]
  promotions        Promotion[]
  suppliers         Supplier[]
  inventoryItems    InventoryItem[]
  stockMovements    StockMovement[]
  inventoryCounts   InventoryCount[]
  stockReceipts     StockReceipt[]
  orders            Order[]
  payments          Payment[]
  diningTables      DiningTable[]
  orderSplits       OrderSplit[]
  orderDiscounts    OrderDiscount[]
  returns           Return[]
  refunds           Refund[]

  @@map("companies")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  tasks               Task[]
  authorizedReturns   Return[]        @relation("ReturnAuthorizedBy")
  processedRefunds    Refund[]        @relation("RefundProcessedBy")
  authorizedDiscounts OrderDiscount[] @relation("DiscountAuthorizedBy")
  voidedDiscounts     OrderDiscount[] @relation("DiscountVoidedBy")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  users User[]

  @@unique([companyId, name])
  @@map("roles")
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  category    String?
  priority    String    @default("normal")
  status      String    @default("pending")
  dueAt       DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@map("tasks")
}

model Incident {
  id          String    @id @default(uuid())
  title       String
  description String?
  category    String?
  severity    String    @default("medium")
  status      String    @default("open")
  occurredAt  DateTime  @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  alternatives IncidentAlternative[]
  experiences  Experience[]

  @@map("incidents")
}

model IncidentAlternative {
  id              String   @id @default(uuid())
  title           String
  description     String?
  cost            Float?
  delayMinutes    Int?
  estimatedLoss   Float?
  continuityScore Int?
  impact          String?
  status          String   @default("proposed")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  incidentId  String
  incident    Incident     @relation(fields: [incidentId], references: [id])
  experiences Experience[]

  @@map("incident_alternatives")
}

model KnowledgeTemplate {
  id          String   @id @default(uuid())
  name        String
  category    String
  description String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  alternatives KnowledgeAlternativeTemplate[]

  @@unique([category, name])
  @@map("knowledge_templates")
}

model KnowledgeAlternativeTemplate {
  id              String   @id @default(uuid())
  title           String
  description     String?
  defaultPriority String   @default("normal")
  order           Int      @default(0)
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  knowledgeTemplateId String
  knowledgeTemplate   KnowledgeTemplate @relation(fields: [knowledgeTemplateId], references: [id], onDelete: Cascade)

  @@unique([knowledgeTemplateId, title])
  @@map("knowledge_alternative_templates")
}

model Event {
  id         String   @id @default(uuid())
  type       String
  source     String?
  entityType String?
  entityId   String?
  data       Json?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  @@index([companyId, type])
  @@index([occurredAt])
  @@map("events")
}

model Workflow {
  id         String   @id @default(uuid())
  name       String
  type       String
  status     String   @default("active")
  entityType String?
  entityId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  steps       WorkflowStep[]
  experiences Experience[]

  @@index([companyId, type])
  @@map("workflows")
}

model WorkflowStep {
  id          String    @id @default(uuid())
  name        String
  stepOrder   Int
  status      String    @default("pending")
  actionType  String?
  data        Json?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, stepOrder])
  @@map("workflow_steps")
}

model Experience {
  id String @id @default(uuid())

  type     String @default("incident_resolution")
  category String

  success Boolean

  delayMinutes      Int?
  extraCost         Float?
  estimatedLoss     Float?
  customersAffected Int?

  notes String?

  selectedAlternativeTitle String?

  verifiedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  selectedAlternativeId String?
  selectedAlternative   IncidentAlternative? @relation(fields: [selectedAlternativeId], references: [id], onDelete: SetNull)

  @@index([companyId, category])
  @@index([incidentId])
  @@index([workflowId])
  @@index([selectedAlternativeId])
  @@map("experiences")
}

model Customer {
  id String @id @default(uuid())

  name  String
  phone String
  email String?

  status String @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  visits  Visit[]
  rewards CustomerReward[]
  orders  Order[]

  @@unique([companyId, phone])
  @@index([companyId])
  @@index([phone])
  @@map("customers")
}

model Visit {
  id String @id @default(uuid())

  source String  @default("manual")
  status String  @default("confirmed")
  notes  String?

  occurredAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  loyaltyProgramId String?
  loyaltyProgram   LoyaltyProgram? @relation(fields: [loyaltyProgramId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([companyId])
  @@index([companyId, occurredAt])
  @@index([loyaltyProgramId])
  @@map("visits")
}

model LoyaltyProgram {
  id String @id @default(uuid())

  name        String
  description String?

  requiredVisits Int

  rewardType        String @default("custom")
  rewardDescription String

  rewardValidDays Int @default(30)

  status String @default("draft")

  startsAt DateTime
  endsAt   DateTime
  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  visits  Visit[]
  rewards CustomerReward[]
  orders  Order[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([startsAt])
  @@index([endsAt])
  @@map("loyalty_programs")
}

model CustomerReward {
  id String @id @default(uuid())

  rewardType        String
  rewardDescription String

  status String @default("available")

  earnedAt   DateTime  @default(now())
  expiresAt  DateTime
  redeemedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  loyaltyProgramId String
  loyaltyProgram   LoyaltyProgram @relation(fields: [loyaltyProgramId], references: [id], onDelete: Cascade)

  @@unique([customerId, loyaltyProgramId])
  @@index([customerId])
  @@index([companyId])
  @@index([loyaltyProgramId])
  @@index([status])
  @@index([expiresAt])
  @@map("customer_rewards")
}

model ProductCategory {
  id String @id @default(uuid())

  name        String
  description String?

  status    String @default("active")
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  products Product[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([status])
  @@map("product_categories")
}

model Product {
  id String @id @default(uuid())

  name        String
  description String?

  type String @default("product")

  sku String?

  price          Float
  compareAtPrice Float?

  trackInventory Boolean @default(true)
  stock          Int     @default(0)
  lowStockAt     Int     @default(5)

  status   String  @default("active")
  featured Boolean @default(false)

  seasonal       Boolean   @default(false)
  seasonStartsAt DateTime?
  seasonEndsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  variants       ProductVariant[]
  images         ProductImage[]
  promotionLinks PromotionProduct[]
  recipe         ProductRecipe?
  orderItems     OrderItem[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([categoryId])
  @@index([type])
  @@index([status])
  @@index([seasonal])
  @@map("products")
}

model ProductVariant {
  id String @id @default(uuid())

  name String
  sku  String?

  price Float?
  stock Int    @default(0)

  attributes Json?

  status String @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  orderItems OrderItem[]

  @@unique([productId, sku])
  @@index([productId])
  @@index([status])
  @@map("product_variants")
}

model ProductImage {
  id String @id @default(uuid())

  url     String
  altText String?

  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isPrimary])
  @@map("product_images")
}

model Promotion {
  id String @id @default(uuid())

  title       String
  description String?

  type  String @default("custom")
  scope String @default("all")

  discountValue Float?
  specialPrice  Float?

  buyQuantity Int?
  getQuantity Int?

  rewardDescription String?
  imageUrl          String?

  featured Boolean @default(false)

  status String @default("draft")

  startsAt DateTime
  endsAt   DateTime
  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  products  PromotionProduct[]
  discounts OrderDiscount[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([startsAt])
  @@index([endsAt])
  @@index([featured])
  @@map("promotions")
}

model PromotionProduct {
  promotionId String
  productId   String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([promotionId, productId])
  @@index([productId])
  @@map("promotion_products")
}

model Site {
  id String @id @default(uuid())

  name String
  slug String @unique

  template String @default("hero")
  status   String @default("draft")

  primaryColor String?
  accentColor  String?

  backgroundType  String  @default("color")
  backgroundValue String?

  logoUrl      String?
  heroImageUrl String?

  heroTitle      String?
  heroSubtitle   String?
  heroButtonText String?
  heroButtonUrl  String?

  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  sections SiteSection[]

  @@index([status])
  @@index([template])
  @@map("sites")
}

model SiteSection {
  id String @id @default(uuid())

  type String

  title String?

  enabled   Boolean @default(true)
  sortOrder Int     @default(0)

  layout String @default("default")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([siteId, sortOrder])
  @@index([type])
  @@map("site_sections")
}

model Supplier {
  id String @id @default(uuid())

  name        String
  contactName String?
  phone       String?
  email       String?
  notes       String?

  trusted Boolean @default(false)
  status  String  @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  stockMovements StockMovement[]
  stockReceipts  StockReceipt[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([status])
  @@index([trusted])
  @@map("suppliers")
}

model InventoryItem {
  id String @id @default(uuid())

  name String
  sku  String?

  kind               String  @default("merchandise")
  unit               String  @default("piece")
  purchaseUnit       String?
  purchaseConversion Float   @default(1)

  quantity     Float @default(0)
  minimumStock Float @default(0)
  averageCost  Float @default(0)

  trackingMode   String    @default("exact")
  countEveryDays Int?
  lastCountedAt  DateTime?

  status String @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  movements        StockMovement[]
  counts           InventoryCount[]
  receiptLines     StockReceiptLine[]
  recipeComponents ProductRecipeComponent[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([kind])
  @@index([status])
  @@map("inventory_items")
}

model StockMovement {
  id String @id @default(uuid())

  direction String
  reason    String

  quantity Float

  unitCost  Float?
  totalCost Float?

  balanceAfter Float

  sourceName String?
  reference  String?
  notes      String?

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([inventoryItemId])
  @@index([supplierId])
  @@index([direction])
  @@index([reason])
  @@index([occurredAt])
  @@map("stock_movements")
}

model InventoryCount {
  id String @id @default(uuid())

  expectedQuantity Float
  countedQuantity  Float
  variance         Float

  reason String?
  notes  String?

  countedAt DateTime @default(now())
  createdAt DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([inventoryItemId])
  @@index([countedAt])
  @@map("inventory_counts")
}

model StockReceipt {
  id String @id @default(uuid())

  sourceType String @default("supplier")

  sourceName String?
  reference  String?
  notes      String?

  totalCost Float @default(0)

  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  lines StockReceiptLine[]

  @@index([companyId])
  @@index([supplierId])
  @@index([receivedAt])
  @@map("stock_receipts")
}

model StockReceiptLine {
  id String @id @default(uuid())

  quantity Float

  receivedUnit String

  conversionToBase Float
  stockQuantity    Float

  unitCost     Float?
  baseUnitCost Float?
  totalCost    Float?

  createdAt DateTime @default(now())

  stockReceiptId String
  stockReceipt   StockReceipt @relation(fields: [stockReceiptId], references: [id], onDelete: Cascade)

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([stockReceiptId])
  @@index([inventoryItemId])
  @@map("stock_receipt_lines")
}

model ProductRecipe {
  id String @id @default(uuid())

  name  String?
  notes String?

  yieldQuantity Float @default(1)

  status String @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  components ProductRecipeComponent[]

  @@index([status])
  @@map("product_recipes")
}

model ProductRecipeComponent {
  id String @id @default(uuid())

  quantity Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipeId String
  recipe   ProductRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([recipeId, inventoryItemId])
  @@index([recipeId])
  @@index([inventoryItemId])
  @@map("product_recipe_components")
}

model Order {
  id String @id @default(uuid())

  orderNumber String

  source    String @default("manual")
  orderType String @default("counter")

  status        String @default("draft")
  paymentStatus String @default("pending")

  subtotal Float @default(0)
  discount Float @default(0)
  total    Float @default(0)

  notes String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?
  cancelledAt DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  loyaltyProgramId String?
  loyaltyProgram   LoyaltyProgram? @relation(fields: [loyaltyProgramId], references: [id], onDelete: SetNull)

  items           OrderItem[]
  payments        Payment[]
  splits          OrderSplit[]
  discounts       OrderDiscount[]
  returns         Return[]        @relation("OriginalOrderReturns")
  exchangeReturns Return[]        @relation("ExchangeOrderReturns")

  diningTableId String?
  diningTable   DiningTable? @relation(fields: [diningTableId], references: [id], onDelete: SetNull)

  @@unique([companyId, orderNumber])
  @@index([companyId])
  @@index([customerId])
  @@index([loyaltyProgramId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id String @id @default(uuid())

  productName String
  sku         String?

  quantity  Float
  unitPrice Float
  lineTotal Float
  discount  Float @default(0)
  total     Float @default(0)

  createdAt DateTime @default(now())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  splitItems  OrderSplitItem[]
  returnItems ReturnItem[]
  discounts   OrderDiscount[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model OrderDiscount {
  id String @id @default(uuid())

  scope  String
  source String @default("manual")
  type   String

  value  Float
  amount Float @default(0)

  reason String
  notes  String?

  status String @default("applied")

  operationId String?

  appliedAt  DateTime  @default(now())
  voidedAt   DateTime?
  voidReason String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  promotionId String?
  promotion   Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  authorizedById String
  authorizedBy   User   @relation("DiscountAuthorizedBy", fields: [authorizedById], references: [id], onDelete: Restrict)

  voidedById String?
  voidedBy   User?   @relation("DiscountVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  @@unique([companyId, operationId])
  @@index([companyId])
  @@index([orderId])
  @@index([orderItemId])
  @@index([promotionId])
  @@index([authorizedById])
  @@index([voidedById])
  @@index([status])
  @@index([appliedAt])
  @@map("order_discounts")
}

model Payment {
  id String @id @default(uuid())

  method String
  status String @default("completed")

  amount         Float
  receivedAmount Float?
  changeAmount   Float  @default(0)

  reference String?
  notes     String?

  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  refunds Refund[]

  sourceReturnId String? @unique
  sourceReturn   Return? @relation("ReturnCreditPayment", fields: [sourceReturnId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([companyId])
  @@index([method])
  @@index([paidAt])
  @@map("payments")
}

model DiningTable {
  id String @id @default(uuid())

  name String
  code String

  area     String?
  capacity Int?

  status String @default("available")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  orders Order[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([status])
  @@map("dining_tables")
}

model OrderSplit {
  id String @id @default(uuid())

  label String

  mode String

  status String @default("open")

  subtotal Float @default(0)
  discount Float @default(0)
  total    Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  items OrderSplitItem[]

  @@index([orderId])
  @@index([companyId])
  @@index([status])
  @@map("order_splits")
}

model OrderSplitItem {
  id String @id @default(uuid())

  quantity Float
  amount   Float

  createdAt DateTime @default(now())

  orderSplitId String
  orderSplit   OrderSplit @relation(fields: [orderSplitId], references: [id], onDelete: Cascade)

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([orderSplitId, orderItemId])
  @@index([orderSplitId])
  @@index([orderItemId])
  @@map("order_split_items")
}

model Return {
  id String @id @default(uuid())

  returnNumber String

  type   String @default("return")
  status String @default("draft")

  reason String
  notes  String?

  totalAmount Float @default(0)

  operationId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  cancelledAt DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  orderId String
  order   Order  @relation("OriginalOrderReturns", fields: [orderId], references: [id], onDelete: Restrict)

  exchangeOrderId String?
  exchangeOrder   Order?  @relation("ExchangeOrderReturns", fields: [exchangeOrderId], references: [id], onDelete: Restrict)

  authorizedById String
  authorizedBy   User   @relation("ReturnAuthorizedBy", fields: [authorizedById], references: [id], onDelete: Restrict)

  items         ReturnItem[]
  refunds       Refund[]
  creditPayment Payment?     @relation("ReturnCreditPayment")

  @@unique([companyId, returnNumber])
  @@unique([companyId, operationId])
  @@index([companyId])
  @@index([orderId])
  @@index([exchangeOrderId])
  @@index([authorizedById])
  @@index([status])
  @@index([createdAt])
  @@map("returns")
}

model ReturnItem {
  id String @id @default(uuid())

  quantity     Float
  unitPrice    Float
  lineTotal    Float
  refundAmount Float

  condition         String @default("sellable")
  disposition       String @default("no_restock")
  restockedQuantity Float  @default(0)

  reason String?
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  returnId     String
  returnRecord Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([returnId, orderItemId])
  @@index([returnId])
  @@index([orderItemId])
  @@index([condition])
  @@index([disposition])
  @@map("return_items")
}

model Refund {
  id String @id @default(uuid())

  method String
  status String @default("completed")

  amount Float

  reference String?
  notes     String?

  operationId String?

  refundedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  returnId     String
  returnRecord Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  processedById String
  processedBy   User   @relation("RefundProcessedBy", fields: [processedById], references: [id], onDelete: Restrict)

  @@unique([companyId, operationId])
  @@index([companyId])
  @@index([returnId])
  @@index([paymentId])
  @@index([processedById])
  @@index([status])
  @@index([refundedAt])
  @@map("refunds")
}
