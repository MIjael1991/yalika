generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        String   @id @default(uuid())
  name      String   @unique
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sites     Site[]

  users             User[]
  roles             Role[]
  tasks             Task[]
  incidents         Incident[]
  events            Event[]
  workflows         Workflow[]
  experiences       Experience[]
  customers         Customer[]
  visits            Visit[]
  loyaltyPrograms   LoyaltyProgram[]
  customerRewards   CustomerReward[]
  commerceCatalogs  CommerceCatalog[]
  productCategories ProductCategory[]
  products          Product[]
  productBarcodes   ProductBarcode[]
  promotions        Promotion[]
  suppliers         Supplier[]
  inventoryItems    InventoryItem[]
  stockMovements    StockMovement[]
  inventoryCounts   InventoryCount[]
  stockReceipts     StockReceipt[]
  posStockReceipts PosStockReceipt[]
  posStockMovements PosStockMovement[]
  orders            Order[]
  payments          Payment[]
  diningTables      DiningTable[]
  orderSplits       OrderSplit[]
  orderDiscounts    OrderDiscount[]
  returns           Return[]
  refunds           Refund[]
  scratchCampaigns  ScratchCampaign[]
  scratchPrizes     ScratchPrize[]
  scratchAttempts   ScratchAttempt[]
  spaces            Space[]
  taskRecurrences   TaskRecurrence[]
  surveys           Survey[]
  surveyRespondents SurveyRespondent[]
  assistantBusinessMemories BusinessAssistantMemory[]
  assistantBusinessActions  BusinessAssistantAction[]

  @@map("companies")
}

model User {
  id                  String    @id @default(uuid())
  name                String
  email               String    @unique
  status              String    @default("active")
  passwordHash        String?
  passwordChangedAt   DateTime?
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  tasks                   Task[]               @relation("TaskAssignee")
  ownedSpaces             Space[]              @relation("SpaceOwner")
  spaceMemberships        SpaceMember[]
  createdTasks            Task[]               @relation("TaskCreator")
  claimedTasks            Task[]               @relation("TaskClaimer")
  completedTasks          Task[]               @relation("TaskCompleter")
  taskActivities          TaskActivity[]       @relation("TaskActivityActor")
  createdTaskRecurrences  TaskRecurrence[]     @relation("TaskRecurrenceCreator")
  assignedTaskRecurrences TaskRecurrence[]     @relation("TaskRecurrenceAssignee")
  taskReminders           TaskReminder[]
  authSessions            AuthSession[]
  authorizedReturns       Return[]             @relation("ReturnAuthorizedBy")
  processedRefunds        Refund[]             @relation("RefundProcessedBy")
  authorizedDiscounts     OrderDiscount[]      @relation("DiscountAuthorizedBy")
  voidedDiscounts         OrderDiscount[]      @relation("DiscountVoidedBy")
  redeemedScratchAttempts ScratchAttempt[]     @relation("ScratchRedeemedBy")
  assistantPreference     AssistantPreference?
  assistantBusinessMemories BusinessAssistantMemory[]
  assistantBusinessActions  BusinessAssistantAction[]
  createdSurveys          Survey[]             @relation("SurveyCreator")

  // Yaleka Mobility
  mobilityDriver         MobilityDriver?
  mobilityPassengerTrips MobilityTrip[]       @relation("MobilityPassenger")
  passwordResetTokens    PasswordResetToken[]
  recoveryKey            AuthRecoveryKey?

  @@map("users")
}

model AssistantPreference {
  id              String   @id @default(uuid())
  preferredName   String?
  automaticLocale Boolean  @default(true)
  voiceLocale     String   @default("es-MX")
  voiceName       String?
  voiceRate       Float    @default(0.95)
  visibleModules  Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("assistant_preferences")
}

model AuthSession {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt, revokedAt])
  @@map("auth_sessions")
}

model Role {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  users User[]

  @@unique([companyId, name])
  @@map("roles")
}

model Space {
  id          String   @id @default(uuid())
  name        String
  description String?
  type        String   @default("personal")
  timezone    String   @default("UTC")
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  ownerUserId String
  owner       User   @relation("SpaceOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)

  members         SpaceMember[]
  tasks           Task[]
  taskRecurrences TaskRecurrence[]

  @@index([companyId, type, status])
  @@index([ownerUserId, status])
  @@map("spaces")
}

model SpaceMember {
  id        String   @id @default(uuid())
  role      String   @default("member")
  status    String   @default("active")
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([spaceId, userId])
  @@index([userId, status])
  @@index([spaceId, role, status])
  @@map("space_members")
}

model Task {
  id               String    @id @default(uuid())
  title            String
  description      String?
  category         String?
  priority         String    @default("normal")
  status           String    @default("pending")
  dueAt            DateTime?
  estimatedMinutes Int?
  postponedUntil   DateTime?
  completedAt      DateTime?
  version          Int       @default(0)
  dedupeKey        String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  userId String?
  user   User?   @relation("TaskAssignee", fields: [userId], references: [id], onDelete: SetNull)

  spaceId String?
  space   Space?  @relation(fields: [spaceId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  claimedById String?
  claimedBy   User?   @relation("TaskClaimer", fields: [claimedById], references: [id], onDelete: SetNull)

  completedById String?
  completedBy   User?   @relation("TaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)

  recurrenceId           String?
  recurrence             TaskRecurrence? @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  recurrenceOccurrenceAt DateTime?

  activities TaskActivity[]
  reminder   TaskReminder?

  @@unique([recurrenceId, recurrenceOccurrenceAt])
  @@index([companyId, status, dueAt])
  @@index([spaceId, status, dueAt])
  @@index([userId, status])
  @@index([recurrenceId, status])
  @@map("tasks")
}

model TaskRecurrence {
  id                    String    @id @default(uuid())
  title                 String
  description           String?
  category              String?
  priority              String    @default("normal")
  estimatedMinutes      Int?
  reminderMinutesBefore Int?
  frequency             String
  interval              Int       @default(1)
  timezone              String    @default("UTC")
  status                String    @default("active")
  startsAt              DateTime
  nextOccurrenceAt      DateTime
  endsAt                DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("TaskRecurrenceCreator", fields: [createdById], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation("TaskRecurrenceAssignee", fields: [userId], references: [id], onDelete: SetNull)

  tasks Task[]

  @@index([spaceId, status, nextOccurrenceAt])
  @@index([companyId, status, nextOccurrenceAt])
  @@index([userId, status])
  @@map("task_recurrences")
}

model TaskReminder {
  id               String    @id @default(uuid())
  leadMinutes      Int
  remindAt         DateTime
  originalRemindAt DateTime
  status           String    @default("scheduled")
  snoozeCount      Int       @default(0)
  acknowledgedAt   DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  taskId String @unique
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status, remindAt])
  @@index([taskId, status])
  @@map("task_reminders")
}

model TaskActivity {
  id         String   @id @default(uuid())
  action     String
  fromStatus String?
  toStatus   String?
  note       String?
  metadata   Json?
  createdAt  DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  actorUserId String?
  actor       User?   @relation("TaskActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("task_activities")
}

model Incident {
  id          String    @id @default(uuid())
  title       String
  description String?
  category    String?
  severity    String    @default("medium")
  status      String    @default("open")
  occurredAt  DateTime  @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  alternatives IncidentAlternative[]
  experiences  Experience[]

  @@map("incidents")
}

model IncidentAlternative {
  id              String   @id @default(uuid())
  title           String
  description     String?
  cost            Float?
  delayMinutes    Int?
  estimatedLoss   Float?
  continuityScore Int?
  impact          String?
  status          String   @default("proposed")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  incidentId  String
  incident    Incident     @relation(fields: [incidentId], references: [id])
  experiences Experience[]

  @@map("incident_alternatives")
}

model KnowledgeTemplate {
  id          String   @id @default(uuid())
  name        String
  category    String
  description String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  alternatives KnowledgeAlternativeTemplate[]

  @@unique([category, name])
  @@map("knowledge_templates")
}

model KnowledgeAlternativeTemplate {
  id              String   @id @default(uuid())
  title           String
  description     String?
  defaultPriority String   @default("normal")
  order           Int      @default(0)
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  knowledgeTemplateId String
  knowledgeTemplate   KnowledgeTemplate @relation(fields: [knowledgeTemplateId], references: [id], onDelete: Cascade)

  @@unique([knowledgeTemplateId, title])
  @@map("knowledge_alternative_templates")
}

model Event {
  id         String   @id @default(uuid())
  type       String
  source     String?
  entityType String?
  entityId   String?
  data       Json?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  @@index([companyId, type])
  @@index([occurredAt])
  @@map("events")
}

model Workflow {
  id         String   @id @default(uuid())
  name       String
  type       String
  status     String   @default("active")
  entityType String?
  entityId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  steps       WorkflowStep[]
  experiences Experience[]

  @@index([companyId, type])
  @@map("workflows")
}

model WorkflowStep {
  id          String    @id @default(uuid())
  name        String
  stepOrder   Int
  status      String    @default("pending")
  actionType  String?
  data        Json?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, stepOrder])
  @@map("workflow_steps")
}

model Experience {
  id String @id @default(uuid())

  type     String @default("incident_resolution")
  category String

  success Boolean

  delayMinutes      Int?
  extraCost         Float?
  estimatedLoss     Float?
  customersAffected Int?

  notes String?

  selectedAlternativeTitle String?

  verifiedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  selectedAlternativeId String?
  selectedAlternative   IncidentAlternative? @relation(fields: [selectedAlternativeId], references: [id], onDelete: SetNull)

  @@index([companyId, category])
  @@index([incidentId])
  @@index([workflowId])
  @@index([selectedAlternativeId])
  @@map("experiences")
}

model Customer {
  id String @id @default(uuid())

  name  String
  phone String
  email String?

  status String @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  visits          Visit[]
  rewards         CustomerReward[]
  orders          Order[]
  scratchAttempts ScratchAttempt[]

  @@unique([companyId, phone])
  @@index([companyId])
  @@index([phone])
  @@map("customers")
}

model Visit {
  id String @id @default(uuid())

  source String  @default("manual")
  status String  @default("confirmed")
  notes  String?

  occurredAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  loyaltyProgramId String?
  loyaltyProgram   LoyaltyProgram? @relation(fields: [loyaltyProgramId], references: [id], onDelete: SetNull)

  scratchAttempt ScratchAttempt?

  @@index([customerId])
  @@index([companyId])
  @@index([companyId, occurredAt])
  @@index([loyaltyProgramId])
  @@map("visits")
}

model LoyaltyProgram {
  id String @id @default(uuid())

  name        String
  description String?

  requiredVisits Int

  rewardType        String @default("custom")
  rewardDescription String

  rewardValidDays Int @default(30)

  status String @default("draft")

  startsAt DateTime
  endsAt   DateTime
  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  visits           Visit[]
  rewards          CustomerReward[]
  orders           Order[]
  scratchCampaigns ScratchCampaign[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([startsAt])
  @@index([endsAt])
  @@map("loyalty_programs")
}

model CustomerReward {
  id String @id @default(uuid())

  rewardType        String
  rewardDescription String

  status String @default("available")

  earnedAt   DateTime  @default(now())
  expiresAt  DateTime
  redeemedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  loyaltyProgramId String
  loyaltyProgram   LoyaltyProgram @relation(fields: [loyaltyProgramId], references: [id], onDelete: Cascade)

  @@unique([customerId, loyaltyProgramId])
  @@index([customerId])
  @@index([companyId])
  @@index([loyaltyProgramId])
  @@index([status])
  @@index([expiresAt])
  @@map("customer_rewards")
}

model ScratchCampaign {
  id String @id @default(uuid())

  name        String
  description String?

  status    String @default("active")
  validDays Int    @default(30)

  startsAt DateTime
  endsAt   DateTime
  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  loyaltyProgramId String
  loyaltyProgram   LoyaltyProgram @relation(fields: [loyaltyProgramId], references: [id], onDelete: Cascade)

  prizes   ScratchPrize[]
  attempts ScratchAttempt[]

  @@index([companyId, status])
  @@index([loyaltyProgramId])
  @@index([startsAt])
  @@index([endsAt])
  @@map("scratch_campaigns")
}

model ScratchPrize {
  id String @id @default(uuid())

  name        String
  description String?

  probabilityBasisPoints Int
  stock                  Int?
  remaining              Int?
  sortOrder              Int    @default(0)
  status                 String @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  campaignId String
  campaign   ScratchCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  attempts ScratchAttempt[]

  @@index([companyId])
  @@index([campaignId, status])
  @@map("scratch_prizes")
}

model ScratchAttempt {
  id String @id @default(uuid())

  status    String
  claimCode String? @unique

  playedAt   DateTime  @default(now())
  expiresAt  DateTime?
  redeemedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visitId String @unique
  visit   Visit  @relation(fields: [visitId], references: [id], onDelete: Restrict)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  campaignId String
  campaign   ScratchCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  prizeId String?
  prize   ScratchPrize? @relation(fields: [prizeId], references: [id], onDelete: SetNull)

  redeemedById String?
  redeemedBy   User?   @relation("ScratchRedeemedBy", fields: [redeemedById], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([companyId, status])
  @@index([campaignId])
  @@index([prizeId])
  @@index([redeemedById])
  @@index([expiresAt])
  @@map("scratch_attempts")
}

model CommerceCatalog {
  id String @id @default(uuid())
  name String
  status String @default("active")
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]
  categories ProductCategory[]
  orders Order[]
  reservations CommerceReservation[]
  sites Site[]

  @@unique([companyId, name])
  @@index([companyId, status])
  @@map("commerce_catalogs")
}

model ProductCategory {
  id String @id @default(uuid())

  name        String
  description String?

  status    String @default("active")
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  products Product[]
  catalogId String?
  catalog CommerceCatalog? @relation(fields: [catalogId], references: [id], onDelete: Restrict)

  @@unique([catalogId, name])
  @@index([catalogId])
  @@index([companyId])
  @@index([status])
  @@map("product_categories")
}

model Product {
  id String @id @default(uuid())

  name        String
  description String?

  type String @default("product")

  sku String?

  price          Float
  compareAtPrice Float?
  unitCost       Float?
  unitsPerPack   Int      @default(1)
  packSalePrice  Float?
  webVisible     Boolean  @default(false)

  trackInventory Boolean @default(true)
  stock          Int     @default(0)
  lowStockAt     Int     @default(5)

  status   String  @default("active")
  featured Boolean @default(false)

  seasonal       Boolean   @default(false)
  seasonStartsAt DateTime?
  seasonEndsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  catalogId String?
  catalog CommerceCatalog? @relation(fields: [catalogId], references: [id], onDelete: Restrict)

  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  variants       ProductVariant[]
  images         ProductImage[]
  promotionLinks PromotionProduct[]
  recipe         ProductRecipe?
  orderItems     OrderItem[]
  posStockMovements PosStockMovement[]
  barcodes          ProductBarcode[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([categoryId])
  @@index([catalogId])
  @@index([type])
  @@index([status])
  @@index([seasonal])
  @@index([companyId, webVisible, status])
  @@map("products")
}

model ProductVariant {
  id String @id @default(uuid())

  name String
  sku  String?

  price Float?
  unitCost Float?
  stock Int    @default(0)

  attributes Json?

  status String @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  orderItems OrderItem[]
  posStockMovements PosStockMovement[]
  barcodes          ProductBarcode[]

  @@unique([productId, sku])
  @@index([productId])
  @@index([status])
  @@map("product_variants")
}

model ProductImage {
  id String @id @default(uuid())

  url     String
  altText String?

  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isPrimary])
  @@map("product_images")
}

model Promotion {
  id String @id @default(uuid())

  title       String
  description String?

  type  String @default("custom")
  scope String @default("all")

  discountValue   Float?
  specialPrice    Float?
  minimumPurchase Float?

  buyQuantity Int?
  getQuantity Int?

  rewardDescription String?
  imageUrl          String?

  featured Boolean @default(false)

  status String @default("draft")

  startsAt DateTime
  endsAt   DateTime
  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  products  PromotionProduct[]
  discounts OrderDiscount[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([startsAt])
  @@index([endsAt])
  @@index([featured])
  @@map("promotions")
}

model PromotionProduct {
  promotionId String
  productId   String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([promotionId, productId])
  @@index([productId])
  @@map("promotion_products")
}

// R7: movimientos de existencias de productos vendibles. No reemplaza InventoryItem para recetas/insumos.
model PosStockReceipt {
  id          String   @id @default(uuid())
  operationId String   @unique
  payloadHash String
  sourceName  String
  reference   String?
  notes       String?
  actorId     String
  totalCost   Float?
  createdAt   DateTime @default(now())

  companyId   String
